          { "label": "Auto (most interesting from here)", "value": "8" },
          { "label": "North", "value": "0" },
          { "label": "North-east", "value": "1" },
          { "label": "East", "value": "2" },
          { "label": "South-east", "value": "3" },
          { "label": "South", "value": "4" },
          { "label": "South-west", "value": "5" },
          { "label": "West", "value": "6" },
          { "label": "North-west", "value": "7" }
        ]
      },
      { "type": "text", "defaultValue": "Directions are on the map, not a compass heading: north-east adds one degree north and one degree east every hour." }
    ]
  },
  {
    "type": "section",
    "items": [
      { "type": "heading", "defaultValue": "Home" },
      { "type": "toggle", "messageKey": "Setting_UsePhone", "label": "Use phone location", "defaultValue": true },
      { "type": "input", "messageKey": "Setting_Lat", "label": "Latitude (manual)", "defaultValue": "", "attributes": { "placeholder": "30.08", "type": "text" } },
      { "type": "input", "messageKey": "Setting_Lon", "label": "Longitude (manual)", "defaultValue": "", "attributes": { "placeholder": "-95.42", "type": "text" } },
      { "type": "text", "defaultValue": "Home is rounded to 0.1 degree (about 10 km) and stays on your phone." }
