  },
  {
    "type": "section",
    "items": [
      { "type": "heading", "defaultValue": "View" },
      {
        "type": "select",
        "messageKey": "Setting_Zoom",
        "label": "Default view",
        "defaultValue": "1",
        "options": [
          { "label": "Hour (about 600 km)", "value": "1" },
          { "label": "Now (about 240 km)", "value": "0" },
          { "label": "Day (the whole route)", "value": "2" },
          { "label": "Globe", "value": "3" }
        ]
      },
      { "type": "text", "defaultValue": "Flick your wrist to cycle Now, Hour, Day and Globe. Over open water the face zooms out to the whole day." }
    ]
